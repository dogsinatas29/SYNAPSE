{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "dist",
        "lib": [
            "ES2020"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "vscode",
            "jest"
        ]
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "ui",
        "demo",
        "prompt-tracer",
        "synapse-visual-architecture-0.1.7",
        "TEST.ts",
        "scratch",
        "test_scan.ts",
        "baseline_capture.ts",
        "graph_diff_audit.ts",
        "step4_verify.ts",
        "verify_registry_runtime.ts",
        "verify_bootstrap_integration.ts",
        "verify_node_builder.ts",
        "verify_cluster_builder.ts",
        "verify_architecture.ts",
        "verify_step2c.ts",
        "verify_step2e.ts",
        "verify_step2f.ts",
        "verify_*.ts"
    ]
}